{
  "name": "font-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/roundtrip.ts",
    "build:single": "vite build --mode single && cp dist-single/index.html melad-font-studio.html"
  },
  "dependencies": {
    "harfbuzzjs": "^1.6.3",
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.6",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
