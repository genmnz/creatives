feature case {
    sub [guilsinglleft guilsinglright guillemotleft guillemotright periodcentered]
     by [guilsinglleft.case guilsinglright.case guillemotleft.case guillemotright.case periodcentered.case];
} case;

feature sups {
    sub @DIGITS by [zero.sups one.sups two.sups three.sups four.sups five.sups six.sups seven.sups eight.sups nine.sups];
} sups;

feature subs {
    sub @DIGITS by [zero.subs one.subs two.subs three.subs four.subs five.subs six.subs seven.subs eight.subs nine.subs];
} subs;
feature sinf {
    sub @DIGITS by [zero.subs one.subs two.subs three.subs four.subs five.subs six.subs seven.subs eight.subs nine.subs];
} sinf;

feature numr {
    sub @DIGITS by @NUMR;
} numr;

feature dnom {
    sub @DIGITS by @DNOM;
} dnom;

feature frac {
    lookup FRAC_PREP {
        sub slash by fraction;
    } FRAC_PREP;
    lookup FRAC_NUMR {
        sub @DIGITS by @NUMR;
    } FRAC_NUMR;
    lookup FRAC_DNOM {
        sub [fraction @DNOM] @NUMR' by @DNOM;
    } FRAC_DNOM;
} frac;

feature ordn {
    sub [A a] by A.ordn;
    sub [O o] by O.ordn;
    sub N o by uni2116;
} ordn;

feature ss01 {
    featureNames { name "Underscored alternates"; };
    sub [A C E O S U Y] by [A.ss01 C.ss01 E.ss01 O.ss01 S.ss01 U.ss01 Y.ss01];
    sub [a c e o s u y] by [a.ss01 c.ss01 e.ss01 o.ss01 s.ss01 u.ss01 y.ss01];
} ss01;

