languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem grek dflt;
languagesystem latn ROM;
languagesystem latn MOL;
languagesystem arab dflt;
languagesystem arab URD;
languagesystem arab FAR;

@DIGITS = [zero one two three four five six seven eight nine];
@NUMR = [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr];
@DNOM = [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom];
@TOP_MARKS = [gravecomb acutecomb circumflexcomb tildecomb macroncomb brevecomb dotaccentcomb dieresiscomb ringcomb hungarumlautcomb caroncomb commaturnedabovecomb];

feature aalt {
    feature locl;
    feature smcp;
    feature c2sc;
    feature sups;
    feature subs;
    feature ordn;
    feature ss01;
    feature case;
} aalt;

feature ccmp {
    lookup DOTLESS {
        lookupflag UseMarkFilteringSet @TOP_MARKS;
        sub [i j]' @TOP_MARKS by [dotlessi uni0237];
    } DOTLESS;
} ccmp;

feature locl {
    script latn;
    language ROM exclude_dflt;
        sub [Scedilla scedilla uni0162 uni0163] by [uni0218 uni0219 uni021A uni021B];
    language MOL exclude_dflt;
        sub [Scedilla scedilla uni0162 uni0163] by [uni0218 uni0219 uni021A uni021B];
} locl;

